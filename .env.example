# Copy to .env (loaded by docker-compose) or export in your shell.

# Required for the copilot (/agent). Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Optional overrides
ANTHROPIC_MODEL=claude-opus-5-5
CAUSAL_COPILOT_FALLBACKS=1          # set 0 to disable the server-side refusal fallback beta
CORS_ORIGINS=http://localhost:3000

# CopilotKit runtime telemetry (anonymous); set to true to opt out
COPILOTKIT_TELEMETRY_DISABLED=true

# Front end -> API (server side, used by the Next.js runtime route)
CAUSAL_AGENT_URL=http://localhost:8000/agent
NEXT_PUBLIC_CAUSAL_API_URL=http://localhost:8000
